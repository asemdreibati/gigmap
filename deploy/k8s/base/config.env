NODE_ENV=production
PORT=3333
LOG_LEVEL=log
SUPABASE_URL=https://your-project-ref.supabase.co
CORS_ORIGINS=https://gigmap.ch
# Readiness fails for this long after SIGTERM before the server closes, so
# Service endpoints are updated before connections are refused. Must stay
# well under terminationGracePeriodSeconds.
SHUTDOWN_DRAIN_MS=10000
# One hop: the ingress controller / load balancer in front of the Service.
TRUST_PROXY_HOPS=1
