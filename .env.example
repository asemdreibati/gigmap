# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env.
# Create the Supabase project in an EU region (Frankfurt) — it cannot be
# changed later, and it matters for nFADP/GDPR posture and latency in CH.
# ---------------------------------------------------------------------------

# --- Database (Supabase Postgres) ------------------------------------------
# Pooled connection (Supavisor transaction mode, port 6543) — used by the running API.
# `connection_limit` is Prisma's pool size per API instance. Supabase's
# serverless guides say 1; that is for one-request-per-process runtimes and
# would serialise every request through one connection in this long-running
# server. Keep (instances x connection_limit) under the pooler's client limit
# for your compute size. See docs/deployment.md.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10"
# Direct connection (port 5432) — used by prisma migrate only.
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# --- Supabase (auth + storage) ---------------------------------------------
SUPABASE_URL="https://<ref>.supabase.co"
# Legacy HS256 projects only: Settings > API > JWT Secret.
# Leave blank on new projects — the guard then verifies asymmetric keys via JWKS.
SUPABASE_JWT_SECRET=""
# For the clients (web/mobile) only; the API never reads it. The service-role
# key is not needed anywhere — keep it out of every environment.
SUPABASE_ANON_KEY=""

# --- Push notifications (Expo) ---------------------------------------------
# Optional. Only needed once you enable enhanced security on Expo push.
EXPO_ACCESS_TOKEN=""

# --- Email (Resend) ---------------------------------------------------------
RESEND_API_KEY=""
ADMIN_EMAIL="you@example.com"

# --- API --------------------------------------------------------------------
PORT=3333
NODE_ENV=development
# Comma-separated. Include your Next.js origin; mobile does not need CORS.
CORS_ORIGINS="http://localhost:3000"
