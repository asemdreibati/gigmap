# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env.
# Create the Supabase project in an EU region (Frankfurt) — it cannot be
# changed later, and it matters for nFADP/GDPR posture and latency in CH.
# ---------------------------------------------------------------------------

# --- Database (Supabase Postgres) ------------------------------------------
# Pooled connection (pgbouncer, port 6543) — used by the running API.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct connection (port 5432) — used by prisma migrate only.
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# --- Supabase (auth + storage) ---------------------------------------------
SUPABASE_URL="https://<ref>.supabase.co"
SUPABASE_ANON_KEY=""
# Server-side only. Used for storage admin + reading auth.users. Never ship to a client.
SUPABASE_SERVICE_ROLE_KEY=""
# Legacy HS256 projects only: Settings > API > JWT Secret.
# Leave blank on new projects — the guard then verifies asymmetric keys via JWKS.
SUPABASE_JWT_SECRET=""

# --- Push notifications (Expo) ---------------------------------------------
# Optional. Only needed once you enable enhanced security on Expo push.
EXPO_ACCESS_TOKEN=""

# --- Email (Resend) ---------------------------------------------------------
RESEND_API_KEY=""
ADMIN_EMAIL="you@example.com"

# --- API --------------------------------------------------------------------
PORT=3333
NODE_ENV=development
# Comma-separated. Include your Next.js origin; mobile does not need CORS.
CORS_ORIGINS="http://localhost:3000"
